# Payment service configuration. Copy to zxavoxpaymentapi/.env and fill in; .env is gitignored.

# ---- Database (its own database, schema pay) ------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=zxavoxpayments
DB_UNAME=postgres
DB_PWORD=

# ---- Secrets --------------------------------------------------------------------------
# REQUIRED. 256-bit key, base64 or hex, encrypting provider credentials: openssl rand -base64 32
# Losing it makes every stored provider secret unreadable.
PAY_SECRETS_KEY=

# The calling system registered (or re-keyed) at startup. Zxadocs sends this as X-Api-Key.
# Generate with: openssl rand -hex 32
PAY_BOOTSTRAP_CLIENT=zxadocs
PAY_BOOTSTRAP_API_KEY=
