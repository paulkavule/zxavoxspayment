# Payment service configuration. Copy to zxavoxpaymentapi/.env and fill in; .env is gitignored.

# ---- Database (its own database, schema payments_api) ---------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=zxavox
DB_UNAME=postgres
DB_PWORD=

# ---- Secrets --------------------------------------------------------------------------
# REQUIRED. 256-bit key, base64 or hex, encrypting provider credentials: openssl rand -base64 32
# Losing it makes every stored provider secret unreadable.
PAY_SECRETS_KEY=

# The calling system registered (or re-keyed) at startup. Zxadocs sends this as X-Api-Key.
# Generate with: openssl rand -hex 32
PAY_BOOTSTRAP_CLIENT=zxadocs
PAY_BOOTSTRAP_API_KEY=

# ---- RabbitMQ (shared with DocsApi in development) --------------------------------------
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=
RABBITMQ_PASSWORD=
RABBITMQ_VHOST=/

# ---- Payments -------------------------------------------------------------------------
# Public base URL for provider callbacks (MTN X-Callback-Url). Empty: no callbacks, the poller alone resolves outcomes.
Payments__CallbackBaseUrl=
# The API client that owns payment.requested events from the broker.
PAY_EVENTS_CLIENT=zxadocs
# Hours a payment is polled before it is left for reconciliation.
PAY_STATUS_CUTOFF_HOURS=24
